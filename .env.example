# Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Target Call & Developer Configuration
DEFAULT_TARGET_PHONE_NUMBER=+919876543210
DEVELOPER_PHONE_NUMBER=+917406209248
RESUME_URL=https://portfolio-aditya-nine-9.vercel.app/
PORTFOLIO_URL=https://portfolio-aditya-nine-9.vercel.app/
ARCHITECTURE_IMAGE_URL=https://portfolio-aditya-nine-9.vercel.app/

# Telephony Provider (OmniDimension)
TELEPHONY_PROVIDER=omnidimension
OMNIDIMENSION_API_KEY=your_omnidimension_api_key_here
OMNIDIMENSION_AGENT_ID=your_omnidimension_agent_id_here

# STT Provider (Sarvam AI Saarika v2.5)
STT_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here

# TTS Provider (Sarvam AI Bulbul v2)
TTS_PROVIDER=sarvam

# LLM Providers (Gemini 2.5 Flash Primary, Groq Llama 3.3 Fallback)
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=groq
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# WhatsApp Provider Configuration (ultramsg / twilio / meta)
WHATSAPP_PROVIDER=ultramsg
ULTRAMSG_INSTANCE_ID=your_instance_id_here
ULTRAMSG_TOKEN=your_ultramsg_token_here

# Twilio WhatsApp (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# Meta WhatsApp Cloud API (Optional)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Google Calendar Scheduling (Optional OAuth)
GOOGLE_CALENDAR_CLIENT_ID=your_calendar_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_calendar_client_secret_here
GOOGLE_CALENDAR_REFRESH_TOKEN=your_calendar_refresh_token_here
GOOGLE_CALENDAR_ID=primary

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
