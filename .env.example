# Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Target Call Configuration
DEFAULT_TARGET_PHONE_NUMBER=+919876543210
DEVELOPER_PHONE_NUMBER=+919876543210

# Telephony Provider (OmniDimension / Vapi / Twilio)
TELEPHONY_PROVIDER=omnidimension
OMNIDIMENSION_API_KEY=your_omnidimension_api_key_here
OMNIDIMENSION_AGENT_ID=your_omnidimension_agent_id_here

# STT Provider (Sarvam AI / Soniox / Deepgram)
STT_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here

# TTS Provider (Sarvam AI / ElevenLabs)
TTS_PROVIDER=sarvam

# LLM Providers (Gemini Flash Primary, Groq Fallback)
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=groq
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_TEMPLATED_MESSAGE=false

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=your_calendar_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_calendar_client_secret_here
GOOGLE_CALENDAR_REFRESH_TOKEN=your_calendar_refresh_token_here
GOOGLE_CALENDAR_ID=primary

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
